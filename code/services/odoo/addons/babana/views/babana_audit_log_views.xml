<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        L8-09, critère 9 (CLAUDE.md, point 9 de la définition de fini) : vue back-office
        consultable et filtrable, réservée aux administrateurs, pour qu'un litige sur une
        remise contestée (ou tout autre événement de la liste) se retrouve depuis l'écran, pas
        depuis les journaux applicatifs. Liste seule (pas de formulaire éditable au sens usuel) :
        le journal est immuable, la vue formulaire ci-dessous n'affiche donc que des champs en
        lecture seule, jamais un bouton d'action.
    -->
    <record id="babana_audit_log_view_list" model="ir.ui.view">
        <field name="name">babana.audit.log.list</field>
        <field name="model">babana.audit.log</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc" create="false" edit="false" delete="false">
                <field name="create_date" string="Horodatage"/>
                <field name="event"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="record_reference" string="Référence"/>
                <field name="actor_id"/>
            </list>
        </field>
    </record>

    <record id="babana_audit_log_view_form" model="ir.ui.view">
        <field name="name">babana.audit.log.form</field>
        <field name="model">babana.audit.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Événement">
                            <field name="create_date" string="Horodatage" readonly="1"/>
                            <field name="actor_id" readonly="1"/>
                            <field name="event" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="record_reference" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Avant">
                            <field name="before" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Après">
                            <field name="after" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Contexte technique">
                            <field name="context_json" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="babana_audit_log_view_search" model="ir.ui.view">
        <field name="name">babana.audit.log.search</field>
        <field name="model">babana.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_reference" string="Référence"/>
                <field name="event"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="actor_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_by_model" string="Modèle" context="{'group_by': 'model_name'}"/>
                    <filter name="group_by_event" string="Événement" context="{'group_by': 'event'}"/>
                    <filter name="group_by_actor" string="Acteur" context="{'group_by': 'actor_id'}"/>
                    <filter name="group_by_day" string="Jour" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="babana_audit_log_action" model="ir.actions.act_window">
        <field name="name">Journal d'audit</field>
        <field name="res_model">babana.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="babana_audit_log_view_search"/>
    </record>

    <menuitem id="babana_menu_audit_log" name="Journal d'audit" parent="babana_menu_root"
        action="babana_audit_log_action" groups="babana.group_babana_admin" sequence="90"/>

    <!--
        D68 (01-architecture.md §9 decies) : un échec d'écriture du journal (critère 3 : il ne
        lève jamais ; critère 2 : personne ne peut l'écrire à sa place) ne laissait de trace que
        dans le journal applicatif que ce module remplace précisément. Cet écran lit le signal
        posé dans ir.config_parameter par babana_audit_log.py::_babana_record_failure_beacon,
        jamais babana.audit.log lui-même, et se place juste avant « Journal d'audit » dans le
        même menu, réservé au même groupe : l'endroit où un administrateur va déjà pour vérifier
        la traçabilité, avant même d'ouvrir la liste.
    -->
    <record id="babana_audit_log_health_view_form" model="ir.ui.view">
        <field name="name">babana.audit.log.health.form</field>
        <field name="model">babana.audit.log.health</field>
        <field name="arch" type="xml">
            <form>
                <!--
                    Boutons au HEADER, pas en FOOTER : cet écran s'ouvre en target="current"
                    (plein écran, comme babana_cash_dashboard_action), et un footer n'est rendu
                    par le client qu'en target="new" (boîte de dialogue), trouvé en vérifiant
                    visuellement cet écran (D68), où « Marquer comme vu » n'apparaissait nulle
                    part. babana_cash_dashboard_view_form (babana_remittance_views.xml) portait le
                    même défaut, plus ancien (L9-05) : corrigé le lendemain (J44), même correctif.
                -->
                <header>
                    <button name="action_acknowledge" type="object" string="Marquer comme vu"
                        class="oe_highlight" invisible="not has_failure"
                        groups="babana.group_babana_admin"/>
                    <button name="action_refresh" type="object" string="Actualiser"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not has_failure">
                        <strong>Le journal d'audit a échoué à s'écrire.</strong> L'opération
                        métier concernée a réussi (le journal ne bloque jamais, critère
                        d'acceptation 3) mais l'entrée correspondante n'existe pas : la
                        traçabilité s'est arrêtée pour cet événement. Vérifier la cause avant
                        d'accuser réception ci-dessus.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="has_failure">
                        Aucun échec d'écriture du journal d'audit depuis le dernier accusé de
                        réception.
                    </div>
                    <group invisible="not has_failure">
                        <field name="failure_count" string="Échecs depuis le dernier accusé de réception"/>
                        <field name="last_failure_at"/>
                        <field name="last_failure_event"/>
                        <field name="last_failure_model_name" string="Modèle concerné"/>
                        <field name="last_failure_error" string="Erreur" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="babana_audit_log_health_action" model="ir.actions.act_window">
        <field name="name">État du journal d'audit</field>
        <field name="res_model">babana.audit.log.health</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="babana_menu_audit_log_health" name="État du journal d'audit" parent="babana_menu_root"
        action="babana_audit_log_health_action" groups="babana.group_babana_admin" sequence="89"/>
</odoo>
