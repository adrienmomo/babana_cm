<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="babana_zone_view_list" model="ir.ui.view">
        <field name="name">babana.zone.list</field>
        <field name="model">babana.zone</field>
        <field name="arch" type="xml">
            <list decoration-info="is_default">
                <field name="name"/>
                <field name="priority"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="babana_zone_view_form" model="ir.ui.view">
        <field name="name">babana.zone.form</field>
        <field name="model">babana.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="not is_default">
                        <strong>Zone par défaut.</strong> Un point qui n'appartient à aucun
                        polygone actif résout ici, jamais en erreur (L2-02) -- c'est le
                        comportement défini pour un trou entre deux zones.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="priority" help="Départage entre zones qui se recouvrent (L9-04) : la plus forte gagne."/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                    <group string="Tracé">
                        <field name="polygon_geojson"
                            help="Objet GeoJSON Polygon. Odoo Communauté n'a pas de widget carte éditable (L9-04) -- utiliser 'Éditer le tracé' ci-dessous pour dessiner visuellement, puis coller le résultat ici."/>
                        <field name="external_editor_url" widget="url" text="Éditer le tracé sur une carte externe (geojson.io)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="babana_zone_action" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">babana.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="babana_menu_zone" name="Zones" parent="babana_menu_pricing"
        action="babana_zone_action" sequence="20"/>
</odoo>
