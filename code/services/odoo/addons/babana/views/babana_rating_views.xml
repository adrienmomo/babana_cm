<?xml version="1.0" encoding="utf-8"?>
<!-- Avis des clients (L4-09). Lecture seule : une note ne se corrige pas, et le commentaire n'est
     visible que d'ici (pas de modération en v1, jamais servi aux apps). -->
<odoo>
    <record id="babana_rating_view_list" model="ir.ui.view">
        <field name="name">babana.rating.list</field>
        <field name="model">babana.rating</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="ride_id"/>
                <field name="driver_id"/>
                <field name="client_id"/>
                <field name="rating"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="babana_rating_view_search" model="ir.ui.view">
        <field name="name">babana.rating.search</field>
        <field name="model">babana.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <field name="ride_id"/>
                <filter name="filter_low" string="Notes de 1 ou 2" domain="[('rating', '&lt;=', 2)]"/>
                <filter name="filter_commented" string="Avec commentaire" domain="[('comment', '!=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_by_driver" string="Chauffeur" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="babana_rating_action" model="ir.actions.act_window">
        <field name="name">Avis</field>
        <field name="res_model">babana.rating</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="babana_rating_view_search"/>
    </record>

    <menuitem id="babana_menu_rating" name="Avis" parent="babana_menu_fleet"
        action="babana_rating_action" sequence="40"/>
</odoo>
