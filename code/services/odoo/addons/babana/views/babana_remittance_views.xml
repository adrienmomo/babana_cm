<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        L5-04 : counted_amount se saisit directement sur le formulaire (champ normal, modifiable
        tant que state == 'declared', babana_cash_remittance.py::write), donc button_validate()
        ne prend aucun argument, contrairement à action_approve/action_reject sur babana.driver
        qui exigent un assistant (babana_driver_views.xml). Bouton réservé à
        group_babana_supervisor : l'appartenance au groupe est ce qui autorise l'écriture
        (ir.model.access.csv), le bouton n'est qu'une commodité d'accès, jamais la seule barrière.
    -->
    <record id="babana_cash_remittance_view_list" model="ir.ui.view">
        <field name="name">babana.cash.remittance.list</field>
        <field name="model">babana.cash.remittance</field>
        <field name="arch" type="xml">
            <!-- L9-05, critère 4 : les remises en attente sont triées par ancienneté, même
                 patron que babana_cash_discrepancy.py::_order pour la même raison (ne rien
                 laisser vieillir en bas d'une liste triée par activité récente). -->
            <list default_order="create_date asc">
                <field name="reference"/>
                <field name="driver_id"/>
                <field name="expected_amount"/>
                <field name="declared_amount"/>
                <field name="counted_amount"/>
                <field name="discrepancy_amount"/>
                <field name="state" decoration-danger="state == 'disputed'" decoration-success="state == 'validated'"/>
            </list>
        </field>
    </record>

    <record id="babana_cash_remittance_view_form" model="ir.ui.view">
        <field name="name">babana.cash.remittance.form</field>
        <field name="model">babana.cash.remittance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_validate" type="object" string="Valider"
                        class="oe_highlight" invisible="state != 'declared'"
                        groups="babana.group_babana_supervisor"/>
                    <field name="state" widget="statusbar" statusbar_visible="declared,validated,disputed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'declared'">
                        <strong>Compter, puis valider.</strong> Le montant compté n'a pas besoin
                        de correspondre au montant attendu ou déclaré pour que la validation
                        fonctionne : une concordance donne <code>validated</code>, un écart donne
                        <code>disputed</code> et ouvre un enregistrement d'écart (L5-06) -- les
                        deux valident la remise (D29). Compter moins que dû n'est pas une erreur
                        à corriger avant de valider, c'est un fait à enregistrer.
                    </div>
                    <div class="alert alert-warning" role="alert"
                        invisible="state not in ('validated', 'disputed') or not discrepancy_amount">
                        <strong>Le chauffeur reste débiteur de <field name="discrepancy_amount" nolabel="1" readonly="1"/>.</strong>
                        Seul le montant compté a remis le solde à zéro (D29) : le reliquat demeure
                        au compte courant du chauffeur et continue de peser sur son plafond
                        d'encaisse -- il ne disparaît pas parce que cette remise est validée. Voir
                        l'écart lié pour son traitement.
                    </div>
                    <group>
                        <group string="Chauffeur">
                            <field name="driver_id" readonly="state != 'draft'"/>
                            <field name="supervisor_id" readonly="1"/>
                        </group>
                        <group string="Montants">
                            <field name="currency_id" invisible="1"/>
                            <field name="expected_amount" readonly="1"/>
                            <field name="declared_amount" readonly="state != 'draft'"/>
                            <field name="counted_amount" readonly="state not in ('declared',)"
                                help="Le montant réellement compté -- il n'a pas à égaler le montant attendu ou déclaré pour valider (D29)."/>
                            <field name="discrepancy_amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Horodatages">
                            <field name="declared_at" readonly="1"/>
                            <field name="validated_at" readonly="1"/>
                        </group>
                        <group string="Comptabilité">
                            <field name="move_id" readonly="1"/>
                            <field name="discrepancy_id" readonly="1" invisible="not discrepancy_id"/>
                        </group>
                    </group>
                    <field name="discrepancy_reason" placeholder="Motif de l'écart, le cas échéant" readonly="state == 'validated'"/>
                    <notebook>
                        <page string="Courses couvertes">
                            <field name="ride_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="final_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="babana_cash_remittance_view_search" model="ir.ui.view">
        <field name="name">babana.cash.remittance.search</field>
        <field name="model">babana.cash.remittance</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="driver_id"/>
                <filter name="filter_declared" string="En attente de validation" domain="[('state', '=', 'declared')]"/>
                <filter name="filter_disputed" string="Contestées" domain="[('state', '=', 'disputed')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_by_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_by_driver" string="Chauffeur" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="babana_cash_remittance_action" model="ir.actions.act_window">
        <field name="name">Remises de caisse</field>
        <field name="res_model">babana.cash.remittance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="babana_cash_remittance_view_search"/>
        <field name="context">{'search_default_filter_declared': 1}</field>
    </record>

    <menuitem id="babana_menu_cash_remittance" name="Remises de caisse" parent="babana_menu_root"
        action="babana_cash_remittance_action" sequence="25"/>

    <!-- Tableau de bord de caisse (L9-05, critère 3) -->
    <record id="babana_cash_dashboard_view_form" model="ir.ui.view">
        <field name="name">babana.cash.dashboard.form</field>
        <field name="model">babana.cash.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <!--
                    Bouton au HEADER, pas en FOOTER : cet écran s'ouvre en target="current"
                    (plein écran), et un footer n'est rendu par le client Odoo 18 qu'en
                    target="new" (boîte de dialogue), trouvé en vérifiant visuellement cet
                    écran (D68 puis D69, nuit J43 puis J44), où « Actualiser » n'apparaissait
                    nulle part malgré le bandeau qui l'annonçait. Même correctif que
                    babana_audit_log_health_view_form (babana_audit_log_views.xml).
                -->
                <header>
                    <button name="action_refresh" type="object" string="Actualiser" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Recalculé à chaque ouverture -- utiliser « Actualiser » ci-dessus pour
                        une lecture à jour sans rouvrir le menu.
                    </div>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="total_held_amount"
                            string="Total détenu par la flotte"
                            help="L'exposition financière de l'entreprise à cet instant (spécification L9-05) -- l'indicateur le plus important de ce tableau de bord."/>
                        <field name="cash_limit" string="Plafond d'encaisse (flotte)"/>
                    </group>
                    <group string="Situation des chauffeurs">
                        <field name="drivers_at_limit_count" string="Chauffeurs au plafond"/>
                        <field name="drivers_near_limit_count" string="Chauffeurs proches du plafond"/>
                    </group>
                    <group string="Remises">
                        <field name="pending_remittances_count" string="Remises en attente de validation"/>
                        <field name="oldest_pending_remittance_id" string="La plus ancienne en attente"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="babana_cash_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tableau de bord de caisse</field>
        <field name="res_model">babana.cash.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="babana_menu_cash_dashboard" name="Tableau de bord de caisse" parent="babana_menu_root"
        action="babana_cash_dashboard_action" sequence="24"/>
</odoo>
