<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_babana_expiry_alerts" model="ir.cron">
        <field name="name">Babana: alertes d'échéance assurance/permis (L1-10)</field>
        <field name="model_id" ref="model_babana_motorcycle"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_babana_purge_expired_replay_ciphertext" model="ir.cron">
        <field name="name">Babana: purge du jeton rejouable chiffré hors fenêtre de grâce (D37, L1-02)</field>
        <field name="model_id" ref="model_babana_token"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_expired_replay_ciphertext()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
