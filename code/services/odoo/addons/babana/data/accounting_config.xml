<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Écriture comptable de la remise de caisse (D8, L5-05). La base de démonstration installe
        le plan comptable générique d'Odoo (generic_coa, comptes anglais 100000-range), pas le
        plan OHADA en usage au Cameroun, qui a ses propres numéros. Plutôt que de réutiliser un
        compte du plan générique en lui prêtant un rôle qu'il ne porte pas (le compte de créance
        générique 121000 sert déjà la facturation client, par exemple), ce module pose ses trois
        propres comptes et son propre journal : des valeurs par défaut explicitement provisoires
        (même réserve que CASH_LIMIT_FALLBACK, babana_driver.py, "à confirmer en pilote"), jamais
        des codes OHADA réels inventés. Numérotation dans la famille OHADA "comptes de tiers"
        (classe 4) à titre indicatif seulement, 421/428 personnel, 47 tiers divers, pas une
        prétention d'exactitude.

        Comptes et journal sont ensuite référencés par ir.config_parameter (invariant 5) : un
        administrateur qui installe un vrai plan OHADA au pilote repointe les quatre paramètres
        vers ses propres comptes, sans toucher au code.

        Le compte de caisse est un enregistrement explicite ici plutôt que le default_account_id
        auto-provisionné par la création d'un journal de type 'cash' (vérifié en écrivant cette
        tâche : Odoo en crée un automatiquement, mais son xmlid n'est pas prévisible depuis ce
        fichier), même compte, juste une référence stable.
    -->
    <record id="babana_cash_remittance_cash_account" model="account.account">
        <field name="name">Caisse chauffeurs (babana)</field>
        <field name="code">57101</field>
        <field name="account_type">asset_cash</field>
    </record>

    <record id="babana_cash_remittance_receivable_account" model="account.account">
        <field name="name">Créances sur les chauffeurs (babana)</field>
        <field name="code">42101</field>
        <field name="account_type">asset_receivable</field>
        <field name="reconcile">True</field>
    </record>

    <record id="babana_cash_remittance_discrepancy_account" model="account.account">
        <field name="name">Écarts de caisse constatés (babana)</field>
        <field name="code">47101</field>
        <field name="account_type">asset_receivable</field>
    </record>

    <record id="babana_cash_remittance_journal" model="account.journal">
        <field name="name">Caisse chauffeurs (babana)</field>
        <field name="code">BCAI</field>
        <field name="type">cash</field>
        <field name="default_account_id" ref="babana_cash_remittance_cash_account"/>
    </record>

    <record id="babana_cash_remittance_journal_param" model="ir.config_parameter">
        <field name="key">babana.cash_remittance_journal_id</field>
        <field name="value" eval="ref('babana_cash_remittance_journal')"/>
    </record>
    <record id="babana_cash_remittance_cash_account_param" model="ir.config_parameter">
        <field name="key">babana.cash_remittance_cash_account_id</field>
        <field name="value" eval="ref('babana_cash_remittance_cash_account')"/>
    </record>
    <record id="babana_cash_remittance_receivable_account_param" model="ir.config_parameter">
        <field name="key">babana.cash_remittance_receivable_account_id</field>
        <field name="value" eval="ref('babana_cash_remittance_receivable_account')"/>
    </record>
    <record id="babana_cash_remittance_discrepancy_account_param" model="ir.config_parameter">
        <field name="key">babana.cash_remittance_discrepancy_account_id</field>
        <field name="value" eval="ref('babana_cash_remittance_discrepancy_account')"/>
    </record>
</odoo>
