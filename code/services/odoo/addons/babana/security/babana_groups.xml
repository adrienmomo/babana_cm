<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_babana" model="ir.module.category">
        <field name="name">Babana</field>
        <field name="sequence">50</field>
    </record>

    <!--
        Les utilisateurs mobiles (clients et chauffeurs) n'appartiennent à aucun de ces trois
        groupes : leurs droits passent exclusivement par des règles d'enregistrement (L8-01),
        pas par le système de groupes du back-office (spécification de L0-02).
    -->

    <record id="group_babana_supervisor" model="res.groups">
        <field name="name">Superviseur</field>
        <field name="category_id" ref="module_category_babana"/>
        <field name="comment">Valide les remises de caisse, consulte les courses.</field>
    </record>

    <record id="group_babana_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="category_id" ref="module_category_babana"/>
        <!-- Un chauffeur approuvé EST un salarié (D5) : la validation de dossier (L1-06,
             action_approve) crée ou rattache une fiche hr.employee, et la fiche back-office
             (L9-01) l'affiche. Le gestionnaire a donc besoin des droits d'agent RH ; sans
             quoi « Approuver / créer une fiche » lève AccessError sur hr.employee /
             resource.calendar, et le formulaire chauffeur ne peut pas montrer employee_id. -->
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Valide les chauffeurs, gère la flotte et les tarifs.</field>
    </record>

    <record id="group_babana_admin" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_babana"/>
        <field name="implied_ids" eval="[(4, ref('group_babana_manager'))]"/>
        <field name="comment">Configuration complète. Hérite du groupe Gestionnaire.</field>
    </record>
</odoo>
