{
  "$comment": "Source canonique de la machine à états de babana.ride. Voir ride-state-machine.md pour le détail narratif de chaque transition. Consommé par verify-ride-state-machine.js et, plus tard, par L4-02/L4-10 pour générer les tests de la machine à états implémentée. Révision C-03R du 10 août 2026 : la règle de partition n'est plus un compte de quatre moments (voir amoa/01-architecture.md §2, révision du 10 août) mais une liste de sept catégories d'événement métier, chacune déclenchée par une décision humaine, jamais par le temps ou la distance.",
  "states": [
    "draft",
    "requested",
    "proposed",
    "assigned",
    "in_progress",
    "completed",
    "settled",
    "rejected",
    "cancelled"
  ],
  "neverTarget": ["draft"],
  "neverSource": ["settled", "cancelled"],
  "businessEvents": [
    { "id": "request_creation", "label": "Création de la demande" },
    { "id": "proposal", "label": "Proposition à un chauffeur" },
    { "id": "acceptance", "label": "Acceptation" },
    { "id": "refusal", "label": "Refus ou expiration" },
    { "id": "cancellation", "label": "Annulation, depuis n'importe quel état" },
    { "id": "ride_completion", "label": "Fin de course" },
    { "id": "settlement", "label": "Encaissement" }
  ],
  "neverWritingTriggers": [
    "position.update",
    "driver.position",
    "eta.recompute",
    "distance.accumulate",
    "countdown.tick",
    "proposal.timer.tick"
  ],
  "transitions": [
    {
      "from": "draft",
      "to": "requested",
      "trigger": "client valide l'estimation",
      "actor": "client",
      "odooWrite": true,
      "businessEvent": "request_creation",
      "irreversible": false
    },
    {
      "from": "requested",
      "to": "proposed",
      "trigger": "select-driver",
      "actor": "client",
      "odooWrite": true,
      "businessEvent": "proposal",
      "irreversible": false
    },
    {
      "from": "proposed",
      "to": "assigned",
      "trigger": "proposal.accept",
      "actor": "driver",
      "odooWrite": true,
      "businessEvent": "acceptance",
      "irreversible": false
    },
    {
      "from": "proposed",
      "to": "rejected",
      "trigger": "proposal.reject | proposal.expired",
      "actor": "driver_or_system",
      "odooWrite": true,
      "businessEvent": "refusal",
      "irreversible": false
    },
    {
      "from": "rejected",
      "to": "proposed",
      "trigger": "select-driver (nouvelle sélection, même course)",
      "actor": "client",
      "odooWrite": true,
      "businessEvent": "proposal",
      "irreversible": false
    },
    {
      "from": "assigned",
      "to": "in_progress",
      "trigger": "ride.start",
      "actor": "driver",
      "odooWrite": false,
      "irreversible": false
    },
    {
      "from": "in_progress",
      "to": "completed",
      "trigger": "ride.complete",
      "actor": "driver",
      "odooWrite": true,
      "businessEvent": "ride_completion",
      "irreversible": true
    },
    {
      "from": "completed",
      "to": "settled",
      "trigger": "settle",
      "actor": "driver",
      "odooWrite": true,
      "businessEvent": "settlement",
      "irreversible": true
    },
    {
      "from": "requested",
      "to": "cancelled",
      "trigger": "cancel",
      "actor": "client_or_supervisor",
      "odooWrite": true,
      "businessEvent": "cancellation",
      "irreversible": true
    },
    {
      "from": "proposed",
      "to": "cancelled",
      "trigger": "cancel",
      "actor": "client_or_supervisor",
      "odooWrite": true,
      "businessEvent": "cancellation",
      "irreversible": true
    },
    {
      "from": "assigned",
      "to": "cancelled",
      "trigger": "cancel",
      "actor": "client_or_driver_or_supervisor",
      "odooWrite": true,
      "businessEvent": "cancellation",
      "irreversible": true
    },
    {
      "from": "rejected",
      "to": "cancelled",
      "trigger": "cancel",
      "actor": "client_or_supervisor",
      "odooWrite": true,
      "businessEvent": "cancellation",
      "irreversible": true
    },
    {
      "from": "in_progress",
      "to": "cancelled",
      "trigger": "cancel (panne, incident, agression)",
      "actor": "driver",
      "odooWrite": true,
      "businessEvent": "cancellation",
      "irreversible": true
    }
  ]
}
