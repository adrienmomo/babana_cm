{
  "name": "@babana/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client REST + JSON-RPC + WebSocket, typé contre @babana/contracts. Export minimal fonctionnel ce soir (L0-03) ; consommé par apps/client et apps/driver dès maintenant, complété au fil des lots L1/L3/L6.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "dependencies": {
    "@babana/contracts": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "react-native-keychain": "^10.0.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react-native": ">=0.86"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "^29.5.13",
    "jest": "^29.6.3",
    "react-native": "0.86.2",
    "typescript": "^5.5.4"
  }
}
