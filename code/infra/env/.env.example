# Copié en infra/env/.env par `make up` au premier lancement (jamais suivi par git, invariant 5).
# Valeurs de développement fonctionnelles ci-dessous ; les secrets portent une valeur
# manifestement factice. Documentation complète variable par variable, format, origine de la
# valeur de production et procédure de rotation : infra/env/README.md (L0-06).

# --- Domaine et TLS ---------------------------------------------------------------------------
BABANA_DOMAIN=localhost
ACME_EMAIL=dev@example.invalid
ADMIN_ALLOWED_IPS=0.0.0.0/0

# --- Environnement -----------------------------------------------------------------------------
NODE_ENV=development

# --- PostgreSQL --------------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=dev-only-not-a-real-secret

# --- Authentification Google (D4) ---------------------------------------------------------------
# Trois identifiants distincts déclarés dans Google Cloud Console (client Android, client iOS,
# client "Web" utilisé côté backend) réunis dans une seule liste séparée par des virgules : Odoo
# accepte un jeton dont l'audience correspond à n'importe lequel des trois. Identifiants réels
# indisponibles cette nuit (D19, aucun compte externe) -- voir amoa/questions/L0-06.md.
GOOGLE_OAUTH_CLIENT_IDS=dev-client-id.apps.googleusercontent.com
# Jeu de clés JWKS servant à vérifier la signature des jetons Google. mock-google-identity
# (L0-08) en développement ; https://www.googleapis.com/oauth2/v3/certs en production (valeur
# par défaut de infra/compose.yaml si la variable est absente -- présente ici par clarté).
GOOGLE_JWKS_URL=http://mock-google-identity:4000/.well-known/jwks.json

# --- Google Sign-In natif (L6-02, D22, apps/client et apps/driver) ------------------------------
# Consommées au moment du build (babel-plugin-transform-inline-environment-variables, apps/*/
# config.ts) par GoogleSignin.configure({ webClientId, iosClientId }) -- PAS un identifiant
# Android : celui-ci se retrouve côté console Google par le nom de package et l'empreinte SHA-1 du
# certificat de signature (une empreinte pour le certificat de développement, une seconde pour
# celui de publication -- oublier la seconde produit une connexion qui marche en développement et
# échoue en production), jamais passé en configuration ici. `BABANA_GOOGLE_WEB_CLIENT_ID` DOIT
# être l'un des identifiants déjà listés dans GOOGLE_OAUTH_CLIENT_IDS ci-dessus : c'est lui qui
# devient l'audience (`aud`) de l'ID token, et c'est cette audience que le backend vérifie --
# configurer une valeur absente de GOOGLE_OAUTH_CLIENT_IDS produit une connexion Google qui
# réussit visuellement puis un INVALID_GOOGLE_TOKEN côté serveur. Identifiants réels indisponibles
# cette nuit (D19, aucun compte externe) -- voir amoa/questions/L0-06.md.
BABANA_GOOGLE_WEB_CLIENT_ID=dev-client-id.apps.googleusercontent.com
BABANA_GOOGLE_IOS_CLIENT_ID=

# --- Jetons applicatifs --------------------------------------------------------------------------
JWT_SECRET=dev-only-not-a-real-secret

# --- Secret partagé Odoo <-> service temps réel ---------------------------------------------------
REALTIME_SHARED_SECRET=dev-only-not-a-real-secret

# --- MinIO / S3 (L1-05) -------------------------------------------------------------------------
MINIO_ROOT_USER=babana-dev
MINIO_ROOT_PASSWORD=dev-only-not-a-real-secret

# --- SMTP (envoi de facture, CDC §III.3) ----------------------------------------------------------
# Même mécanisme que GOOGLE_JWKS_URL pour mock-google-identity (D19) : une seule variable dont
# la valeur change selon l'environnement, pas un jeu de variables *_PROD_* documenté par
# anticipation. mailpit (L0-08, infra/compose.dev.yaml) en développement -- capture tout, aucune
# authentification. Un relais SMTP réel en recette et en production (fournisseur à choisir, voir
# amoa/questions/L0-06.md).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@babana.cm

# --- Notifications push (Firebase Cloud Messaging, CDC §III.4/§IV.1) -------------------------------
# Non consommées en développement : L1-09/L7-01 (hors de ce soir) journalisent au lieu d'envoyer
# (D19). Format : compte de service FCM (API HTTP v1), pas l'ancienne clé serveur "legacy".
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Passerelle SMS (rattachement de numéro, CDC §VII.1) -------------------------------------------
# Non consommées en développement : L1-09 (hors de ce soir) journalise le code OTP au lieu de
# l'envoyer (D19). Fournisseur définitif non tranché -- voir amoa/questions/L0-06.md.
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=BABANA

# --- Cartographie (Google Maps, D13) --------------------------------------------------------------
# Consommée par apps/* au moment du build natif (L6-01, hors de ce soir). mock-maps (L0-08) sert
# de doublure complète en développement, cette clé n'y est jamais utilisée.
GOOGLE_MAPS_API_KEY=
# Distincte de la précédente : celle-ci alimente les appels REST du fournisseur (Places,
# Geocoding -- packages/maps/src/providers/google/config.ts), pas le rendu natif de la carte.
# Injectée par `src/bootstrap.ts` de chaque app (L6-00, critère d'acceptation 7 : un seul appel à
# `configureMapsProvider` au démarrage). Deux clés Google Cloud Console distinctes en production,
# restreintes différemment (l'une par empreinte d'app, l'autre par API activée) -- jamais la même
# valeur recopiée deux fois.
BABANA_GOOGLE_MAPS_API_KEY=
# Adresse de la recherche de lieu (`searchPlace`, L6-01) -- même mécanisme que
# GOOGLE_ROUTING_URL ci-dessous : mock-maps (L0-08) en développement, l'API Google réelle si la
# variable est absente (valeur par défaut dans providers/google/places.ts). mock-maps expose son
# port directement à l'hôte (infra/compose.dev.yaml, ports 4001:4001) : le navigateur qui exécute
# l'app web l'atteint sans passer par Caddy. Sans cette variable en développement, aucun point de
# départ ni d'arrivée n'est désignable par recherche (D19, amoa/questions/C-01R.md §2).
BABANA_MAPS_SEARCH_URL=http://localhost:4001/search
# Distance de référence (L2-05, É8 : modèle voiture, ni Google ni Mapbox ne routent les
# deux-roues au Cameroun). Même mécanisme que GOOGLE_JWKS_URL : mock-maps (L0-08) en
# développement, une vraie API de routage en production -- le code de services/routing.py ne
# change jamais, seule cette adresse change (valeur par défaut de infra/compose.yaml si absente
# -- présente ici par clarté).
GOOGLE_ROUTING_URL=http://mock-maps:4001/route
