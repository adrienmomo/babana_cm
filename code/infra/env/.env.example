# Copié en infra/env/.env par `make up` au premier lancement (jamais suivi par git, invariant 5).
# Valeurs de développement fonctionnelles ci-dessous ; les secrets portent une valeur
# manifestement factice. Documentation complète variable par variable, format, origine de la
# valeur de production et procédure de rotation : infra/env/README.md (L0-06).
#
# EXCEPTION (D43 retournée, amoa/questions/REPONSES-2026-09-06.md §2) : les adresses qui
# désignent un fournisseur externe réel ou son simulateur -- GOOGLE_JWKS_URL, GOOGLE_ROUTING_URL,
# BABANA_MAPS_SEARCH_URL, SMTP_HOST/PORT -- n'ont **pas** de valeur ici. Vide. La valeur de
# développement (vers les simulateurs L0-08, vers mailpit) est posée explicitement par
# infra/compose.dev.yaml ; la production les renseigne vers les vrais fournisseurs. Motif : une
# mise en production qui recopie ce fichier ne doit jamais hériter d'une adresse de simulateur --
# mailpit surtout, qui accepte une facture et ne signale rien.

# --- Domaine et TLS ---------------------------------------------------------------------------
BABANA_DOMAIN=localhost
ACME_EMAIL=dev@example.invalid
# Liste d'adresses autorisées à joindre le back-office (admin.<domaine>). CIDR séparés par des
# virgules. 0.0.0.0/0 en développement (ouvert) ; en production, les adresses de l'équipe.
ADMIN_ALLOWED_IPS=0.0.0.0/0
# Liste d'adresses autorisées à joindre le domaine principal -- bundle web du Client ET les
# `/api/*`, `/rt/*`, `/s/*` proxifiés sous la même origine (D46, L6-18). Tant que les
# habilitations (L8-01, L8-02) n'existent pas, la démonstration reste derrière cette liste
# (prompt J29 : « l'accès reste fermé »). Distincte d'ADMIN_ALLOWED_IPS : on peut ouvrir la
# démonstration au client sans lui ouvrir le back-office. 0.0.0.0/0 en développement.
WEB_ALLOWED_IPS=0.0.0.0/0

# --- Environnement -----------------------------------------------------------------------------
NODE_ENV=development

# --- PostgreSQL --------------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=dev-only-not-a-real-secret

# --- Back-office : compte administrateur --------------------------------------------------------
# Secret ordinaire (comme POSTGRES_PASSWORD ci-dessus), pas une adresse de fournisseur externe :
# contrairement à GOOGLE_JWKS_URL et consorts, cette valeur est lue aussi bien par le conteneur
# odoo que par des outils hôte (test/concurrency/helpers/odoo-session.ts, fixtures de test) --
# elle doit donc rester lisible depuis ce fichier, pas seulement posée dans
# infra/compose.dev.yaml. __init__.py::_post_init_admin_password l'applique au compte `admin` à
# l'installation du module babana (post_init_hook, ne rejoue pas sur `-u` -- rotation ultérieure :
# voir infra/env/README.md). En production, à fournir explicitement avant
# infra/production/deploy.sh, qui refuse de partir si la variable est vide ou égale à cette
# valeur de développement.
ADMIN_PASSWORD=dev-only-not-a-real-secret

# --- Authentification Google (D4) ---------------------------------------------------------------
# Trois identifiants distincts déclarés dans Google Cloud Console (client Android, client iOS,
# client "Web" utilisé côté backend) réunis dans une seule liste séparée par des virgules : Odoo
# accepte un jeton dont l'audience correspond à n'importe lequel des trois. Identifiants réels
# indisponibles cette nuit (D19, aucun compte externe) -- voir amoa/questions/L0-06.md.
GOOGLE_OAUTH_CLIENT_IDS=dev-client-id.apps.googleusercontent.com
# Jeu de clés JWKS servant à vérifier la signature d'un jeton dont l'émetteur (`iss`) est le
# vrai Google (D75, amoa/01-architecture.md §9 septdecies) -- le jeton choisit le jeu de clés,
# jamais une adresse unique de configuration. PAS de valeur ici (D43, voir l'en-tête) : le
# développement reçoit un défaut vers mock-google-identity dans infra/compose.dev.yaml
# (http://mock-google-identity:4000/.well-known/jwks.json, pour que `make up` fonctionne sans
# aucun compte externe, D19) ; poser ici https://www.googleapis.com/oauth2/v3/certs pour tester
# une vraie connexion Google en développement, EN PLUS de GOOGLE_JWKS_URL_MOCK ci-dessous --
# c'est ce qui permet à une démonstration de montrer une vraie connexion à l'écran et des
# chauffeurs simulés qui bougent en même temps, sans plus jamais éditer un fichier suivi pour y
# arriver. La production la pose vers la même vraie adresse ; non configurée là-bas :
# google_identity.py::_jwks_url_for_issuer lève une erreur, et deploy.sh refuse de partir.
GOOGLE_JWKS_URL=

# Jeu de clés JWKS de mock-google-identity (L0-08, D75) -- ABSENTE par défaut, y compris en
# développement dans ce fichier : infra/compose.dev.yaml la pose, elle, systématiquement (le
# simulateur n'a qu'une seule adresse possible, il n'y a rien à choisir). Son absence retire la
# possibilité d'accepter l'émetteur simulé, elle n'est pas un drapeau qu'on pourrait oublier de
# baisser (même forme que D43) : deploy.sh refuse un déploiement de production qui la listerait.
GOOGLE_JWKS_URL_MOCK=

# --- Jetons applicatifs --------------------------------------------------------------------------
JWT_SECRET=dev-only-not-a-real-secret

# --- Secret partagé Odoo <-> service temps réel ---------------------------------------------------
REALTIME_SHARED_SECRET=dev-only-not-a-real-secret

# --- MinIO / S3 (L1-05) -------------------------------------------------------------------------
MINIO_ROOT_USER=babana-dev
MINIO_ROOT_PASSWORD=dev-only-not-a-real-secret
# Point d'entrée PUBLIC du stockage (D64, amoa/01-architecture.md §9 octies) -- distinct de
# S3_ENDPOINT (nom de service Docker interne, fixé en dur dans infra/compose.yaml, jamais ici :
# voir docs/operations/configuration.md, INTERNAL_TOPOLOGY_NAMES). C'est cette adresse que
# services/storage.py utilise pour SIGNER une URL destinée à un navigateur -- jamais pour écrire.
# PAS de valeur ici (D43, voir l'en-tête) : infra/compose.dev.yaml pose http://localhost:9000 (le
# port MinIO déjà publié à l'hôte) ; la production pose l'hôte servi par Caddy
# (https://storage.<domaine>, qui ne proxifie que l'API S3 de MinIO, jamais sa console). Non
# configurée, generate_signed_url() lève au lieu de retomber sur l'adresse interne -- c'est
# exactement ce repli silencieux qui a produit le défaut du 16 septembre.
S3_PUBLIC_ENDPOINT=

# --- SMTP (envoi de facture, CDC §III.3) ----------------------------------------------------------
# SMTP_HOST/PORT : PAS de valeur ici (D43 retournée, voir l'en-tête). C'est le cas qui a motivé
# la règle : `SMTP_HOST=mailpit` recopié en production enverrait les factures au simulateur, qui
# les accepte et ne signale rien. Le développement reçoit mailpit / 1025 de
# infra/compose.dev.yaml ; la production pose le relais SMTP réel (fournisseur à choisir, voir
# amoa/questions/L0-06.md). Non configuré : deploy.sh refuse de partir.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM n'est pas une adresse de fournisseur mais celle du domaine babana.cm : identique dans
# tous les environnements, elle garde donc sa valeur.
SMTP_FROM=no-reply@babana.cm

# --- Notifications push (Firebase Cloud Messaging, CDC §III.4/§IV.1) -------------------------------
# PUSH_PROVIDER choisit l'implémentation de services/push.py (L7-01) : 'console' (défaut) journalise
# la notification au lieu de l'envoyer et n'exige aucun compte Firebase (D19) ; 'fcm' active
# l'envoi réel (API HTTP v1) et exige alors les trois variables ci-dessous. Aucun repli : avec
# PUSH_PROVIDER=fcm et une variable manquante, Odoo échoue bruyamment plutôt que de retomber sur
# le simulateur ou sur un envoi inattendu (D43).
PUSH_PROVIDER=console
# Compte de service FCM (API HTTP v1), pas l'ancienne clé serveur "legacy". FCM_PRIVATE_KEY peut
# contenir des "\n" littéraux (échappés par la plateforme d'hébergement) -- push.py les rétablit.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- SMS (code OTP de rattachement de numéro, CDC §VII.1) ------------------------------------------
# SMS_PROVIDER choisit l'implémentation de services/sms.py (L1-09) : 'console' (défaut) écrit le
# code dans les journaux et n'exige aucun compte (D19) ; 'tidjani_brothers' envoie réellement par
# l'API SMS Tidjani & Brothers et exige alors TB_SMS_API_URL et TB_SMS_API_KEY. Aucun repli : avec
# 'tidjani_brothers' et une variable manquante, Odoo échoue bruyamment (D43). Ajouter une autre
# passerelle = une classe dans services/sms.py + une valeur ici.
SMS_PROVIDER=console
TB_SMS_API_URL=https://tidjaniandbrothers.com/api/sms/v1
# Clé créée dans l'espace client (https://tidjaniandbrothers.com/sms/cles-api), affichée une seule
# fois. Chaque clé est liée à UN expéditeur approuvé : il n'y a pas de réglage d'expéditeur ici.
TB_SMS_API_KEY=
# Secondes, facultatif (15 par défaut).
TB_SMS_TIMEOUT=15
# Développement seulement : impose ce code (six chiffres, ex. 000000) à tous les OTP, ce qui évite
# de lire les journaux. Ignoré dès que SMS_PROVIDER n'est pas 'console'. Laisser vide ailleurs.
OTP_DEV_FIXED_CODE=

# --- Cartographie (Google Maps, D13) --------------------------------------------------------------
# Consommée par apps/* au moment du build natif (L6-01, hors de ce soir). mock-maps (L0-08) sert
# de doublure complète en développement, cette clé n'y est jamais utilisée.
GOOGLE_MAPS_API_KEY=
# Distincte de la précédente : celle-ci alimente les appels REST du fournisseur (Places,
# Geocoding -- packages/maps/src/providers/google/config.ts), pas le rendu natif de la carte.
# Injectée par `src/bootstrap.ts` de chaque app (L6-00, critère d'acceptation 7 : un seul appel à
# `configureMapsProvider` au démarrage). Deux clés Google Cloud Console distinctes en production,
# restreintes différemment (l'une par empreinte d'app, l'autre par API activée) -- jamais la même
# valeur recopiée deux fois.
BABANA_GOOGLE_MAPS_API_KEY=
# Adresse de la recherche de lieu (`searchPlace`, L6-01), consommée au **build** de l'app (donc
# lue de `process.env` de l'hôte, jamais d'un conteneur). PAS de valeur ici (D43, voir
# l'en-tête) : `make client` / `make client-web` posent la valeur de développement
# (http://localhost:4001/v1/places:searchText -- mock-maps expose son port à l'hôte, le navigateur l'atteint
# sans passer par Caddy) ; un build de production pose l'adresse Google réelle. Non configurée,
# searchPlace lève au lieu d'appeler silencieusement Google. Le scénario de démonstration désigne
# les points en glissant la carte, pas par recherche -- cette variable n'y est pas requise.
BABANA_MAPS_SEARCH_URL=
# Géocodage inverse (`reverseGeocode`, libellé du point désigné) : même règle que
# BABANA_MAPS_SEARCH_URL -- PAS de valeur ici ; `make client` / `make client-web` posent
# http://localhost:4001/maps/api/geocode/json (mock-maps), un build de production pose
# https://maps.googleapis.com/maps/api/geocode/json. Non configurée, reverseGeocode lève.
BABANA_MAPS_GEOCODE_URL=
# Tuiles de la carte OpenStreetMap native des apps Chauffeur et Client (`https://.../{z}/{x}/{y}.png`), consommées
# au **build**. PAS de valeur ici (D43) : `make driver` / `make client` (et `-app`) posent la valeur de
# développement (tile.openstreetmap.org, interdit en usage intensif et sans garantie de service) ;
# un build de production pose le fournisseur de tuiles retenu. Non configurée, la carte reste celle
# de Google. La recherche de lieu reste celle de Google dans les deux cas. `{r}` dans l'adresse :
# tuiles @2x sur écran dense, si le fournisseur les sert.
BABANA_MAP_TILE_URL=
# Crédit exigé par la licence du fournisseur de tuiles ci-dessus, affiché sur la carte. Requis dès
# que BABANA_MAP_TILE_URL est posée (D43 : aucun texte par défaut) ; `make driver` / `make client`
# posent celui d'OpenStreetMap en développement.
BABANA_MAP_TILE_ATTRIBUTION=
# Service de routage (format OSRM) de l'app Chauffeur : itinéraire vers le client puis vers la
# destination, partagé au Client. Consommé au **build**, PAS de valeur ici (D43) : `make driver` pose
# le serveur de démonstration public (usage léger, développement seulement) ; la production pose le
# service retenu. Non configuré, la carte reste sans tracé. É8 : modèle voiture.
BABANA_ROUTING_URL=
# Rayon (m) sous lequel « Sur place » apparaît (défaut 150) et délai (ms) avant de redemander un
# itinéraire en échec (défaut 15000) -- optionnels, consommés au build.
BABANA_ARRIVAL_RADIUS_METERS=
BABANA_ROUTE_RETRY_COOLDOWN_MS=
# Recalcul de l'itinéraire en course : écart au tracé (m, défaut 80) et âge maximal (ms, défaut
# 120000) -- optionnels, consommés au build.
BABANA_ROUTE_DEVIATION_METERS=
BABANA_ROUTE_REFRESH_MS=
# Adresse de l'API et du service temps réel pour les applications natives (Client, Chauffeur),
# consommées au **build** (donc lues de `process.env` de l'hôte, jamais d'un conteneur). PAS de
# valeur ici (D43 retournée, D61 -- amoa/questions/REPONSES-2026-09-14.md §3) : `make client` /
# `make driver` posent la valeur de développement (https://api.localhost, wss://api.localhost/rt/
# ws) ; un build de production pose le domaine réel. Ont porté la valeur de production en repli
# jusqu'au 14 septembre -- un binaire construit sans ces variables parlait alors à la vraie
# production sans le signaler (D43 : un repli plausible se croit, une absence se voit). Non
# configurée, apps/*/config.ts lève au lieu de deviner.
BABANA_API_URL=
BABANA_REALTIME_WS_URL=
# Distance de référence (L2-05, É8 : modèle voiture, ni Google ni Mapbox ne routent les
# deux-roues au Cameroun). PAS de valeur ici (D43, voir l'en-tête) : infra/compose.dev.yaml pose
# http://mock-maps:4001/route pour le développement, la production pose une vraie API de routage.
# routing.py::_routing_url lève si la variable est absente ; deploy.sh refuse de partir.
GOOGLE_ROUTING_URL=
