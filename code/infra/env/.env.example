# Copié en infra/env/.env par `make up` au premier lancement (jamais suivi par git).
# Valeurs de développement fonctionnelles ci-dessous ; les secrets portent une valeur
# manifestement factice (invariant 5). Documentation complète variable par variable,
# avec procédure de rotation : infra/env/README.md (L0-06).

# --- Domaine et TLS -----------------------------------------------------------------------
BABANA_DOMAIN=localhost
ACME_EMAIL=dev@example.invalid
ADMIN_ALLOWED_IPS=0.0.0.0/0

# --- Environnement --------------------------------------------------------------------------
NODE_ENV=development

# --- PostgreSQL -----------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=dev-only-not-a-real-secret

# --- Authentification Google (D4) ------------------------------------------------------------
# Identifiants réels indisponibles cette nuit (D19) : voir amoa/questions/L0-06.md dès qu'il
# existe. GOOGLE_JWKS_URL pointe vers le service simulé de L0-08 en développement.
GOOGLE_OAUTH_CLIENT_IDS=dev-client-id.apps.googleusercontent.com
GOOGLE_JWKS_URL=http://mock-google-identity:4000/.well-known/jwks.json

# --- Jetons applicatifs -----------------------------------------------------------------------
JWT_SECRET=dev-only-not-a-real-secret

# --- Secret partagé Odoo <-> service temps réel ------------------------------------------------
REALTIME_SHARED_SECRET=dev-only-not-a-real-secret

# --- MinIO (S3, L1-05) ------------------------------------------------------------------------
MINIO_ROOT_USER=babana-dev
MINIO_ROOT_PASSWORD=dev-only-not-a-real-secret
