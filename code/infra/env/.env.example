# Copié en infra/env/.env par `make up` au premier lancement (jamais suivi par git, invariant 5).
# Valeurs de développement fonctionnelles ci-dessous ; les secrets portent une valeur
# manifestement factice. Documentation complète variable par variable, format, origine de la
# valeur de production et procédure de rotation : infra/env/README.md (L0-06).
#
# EXCEPTION (D43 retournée, amoa/questions/REPONSES-2026-09-06.md §2) : les adresses qui
# désignent un fournisseur externe réel ou son simulateur -- GOOGLE_JWKS_URL, GOOGLE_ROUTING_URL,
# BABANA_MAPS_SEARCH_URL, SMTP_HOST/PORT -- n'ont **pas** de valeur ici. Vide. La valeur de
# développement (vers les simulateurs L0-08, vers mailpit) est posée explicitement par
# infra/compose.dev.yaml ; la production les renseigne vers les vrais fournisseurs. Motif : une
# mise en production qui recopie ce fichier ne doit jamais hériter d'une adresse de simulateur --
# mailpit surtout, qui accepte une facture et ne signale rien.

# --- Domaine et TLS ---------------------------------------------------------------------------
BABANA_DOMAIN=localhost
ACME_EMAIL=dev@example.invalid
# Liste d'adresses autorisées à joindre le back-office (admin.<domaine>). CIDR séparés par des
# virgules. 0.0.0.0/0 en développement (ouvert) ; en production, les adresses de l'équipe.
ADMIN_ALLOWED_IPS=0.0.0.0/0
# Liste d'adresses autorisées à joindre le domaine principal -- bundle web du Client ET les
# `/api/*`, `/rt/*`, `/s/*` proxifiés sous la même origine (D46, L6-18). Tant que les
# habilitations (L8-01, L8-02) n'existent pas, la démonstration reste derrière cette liste
# (prompt J29 : « l'accès reste fermé »). Distincte d'ADMIN_ALLOWED_IPS : on peut ouvrir la
# démonstration au client sans lui ouvrir le back-office. 0.0.0.0/0 en développement.
WEB_ALLOWED_IPS=0.0.0.0/0

# --- Environnement -----------------------------------------------------------------------------
NODE_ENV=development

# --- PostgreSQL --------------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=dev-only-not-a-real-secret

# --- Authentification Google (D4) ---------------------------------------------------------------
# Trois identifiants distincts déclarés dans Google Cloud Console (client Android, client iOS,
# client "Web" utilisé côté backend) réunis dans une seule liste séparée par des virgules : Odoo
# accepte un jeton dont l'audience correspond à n'importe lequel des trois. Identifiants réels
# indisponibles cette nuit (D19, aucun compte externe) -- voir amoa/questions/L0-06.md.
GOOGLE_OAUTH_CLIENT_IDS=dev-client-id.apps.googleusercontent.com
# Jeu de clés JWKS servant à vérifier la signature des jetons Google. PAS de valeur ici (D43,
# voir l'en-tête) : le développement la reçoit de infra/compose.dev.yaml
# (http://mock-google-identity:4000/.well-known/jwks.json), la production la pose vers
# https://www.googleapis.com/oauth2/v3/certs. Non configurée : google_identity.py::_jwks_url
# lève une erreur, et deploy.sh refuse de partir.
GOOGLE_JWKS_URL=

# --- Google Sign-In natif (L6-02, D22, apps/client et apps/driver) ------------------------------
# Consommées au moment du build (babel-plugin-transform-inline-environment-variables, apps/*/
# config.ts) par GoogleSignin.configure({ webClientId, iosClientId }) -- PAS un identifiant
# Android : celui-ci se retrouve côté console Google par le nom de package et l'empreinte SHA-1 du
# certificat de signature (une empreinte pour le certificat de développement, une seconde pour
# celui de publication -- oublier la seconde produit une connexion qui marche en développement et
# échoue en production), jamais passé en configuration ici. `BABANA_GOOGLE_WEB_CLIENT_ID` DOIT
# être l'un des identifiants déjà listés dans GOOGLE_OAUTH_CLIENT_IDS ci-dessus : c'est lui qui
# devient l'audience (`aud`) de l'ID token, et c'est cette audience que le backend vérifie --
# configurer une valeur absente de GOOGLE_OAUTH_CLIENT_IDS produit une connexion Google qui
# réussit visuellement puis un INVALID_GOOGLE_TOKEN côté serveur. Identifiants réels indisponibles
# cette nuit (D19, aucun compte externe) -- voir amoa/questions/L0-06.md.
BABANA_GOOGLE_WEB_CLIENT_ID=dev-client-id.apps.googleusercontent.com
BABANA_GOOGLE_IOS_CLIENT_ID=

# --- Jetons applicatifs --------------------------------------------------------------------------
JWT_SECRET=dev-only-not-a-real-secret

# --- Secret partagé Odoo <-> service temps réel ---------------------------------------------------
REALTIME_SHARED_SECRET=dev-only-not-a-real-secret

# --- MinIO / S3 (L1-05) -------------------------------------------------------------------------
MINIO_ROOT_USER=babana-dev
MINIO_ROOT_PASSWORD=dev-only-not-a-real-secret

# --- SMTP (envoi de facture, CDC §III.3) ----------------------------------------------------------
# SMTP_HOST/PORT : PAS de valeur ici (D43 retournée, voir l'en-tête). C'est le cas qui a motivé
# la règle : `SMTP_HOST=mailpit` recopié en production enverrait les factures au simulateur, qui
# les accepte et ne signale rien. Le développement reçoit mailpit / 1025 de
# infra/compose.dev.yaml ; la production pose le relais SMTP réel (fournisseur à choisir, voir
# amoa/questions/L0-06.md). Non configuré : deploy.sh refuse de partir.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM n'est pas une adresse de fournisseur mais celle du domaine babana.cm : identique dans
# tous les environnements, elle garde donc sa valeur.
SMTP_FROM=no-reply@babana.cm

# --- Notifications push (Firebase Cloud Messaging, CDC §III.4/§IV.1) -------------------------------
# PUSH_PROVIDER choisit l'implémentation de services/push.py (L7-01) : 'console' (défaut) journalise
# la notification au lieu de l'envoyer et n'exige aucun compte Firebase (D19) ; 'fcm' active
# l'envoi réel (API HTTP v1) et exige alors les trois variables ci-dessous. Aucun repli : avec
# PUSH_PROVIDER=fcm et une variable manquante, Odoo échoue bruyamment plutôt que de retomber sur
# le simulateur ou sur un envoi inattendu (D43).
PUSH_PROVIDER=console
# Compte de service FCM (API HTTP v1), pas l'ancienne clé serveur "legacy". FCM_PRIVATE_KEY peut
# contenir des "\n" littéraux (échappés par la plateforme d'hébergement) -- push.py les rétablit.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Passerelle SMS (rattachement de numéro, CDC §VII.1) -------------------------------------------
# Non consommées en développement : L1-09 (hors de ce soir) journalise le code OTP au lieu de
# l'envoyer (D19). Fournisseur définitif non tranché -- voir amoa/questions/L0-06.md.
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=BABANA

# --- Cartographie (Google Maps, D13) --------------------------------------------------------------
# Consommée par apps/* au moment du build natif (L6-01, hors de ce soir). mock-maps (L0-08) sert
# de doublure complète en développement, cette clé n'y est jamais utilisée.
GOOGLE_MAPS_API_KEY=
# Distincte de la précédente : celle-ci alimente les appels REST du fournisseur (Places,
# Geocoding -- packages/maps/src/providers/google/config.ts), pas le rendu natif de la carte.
# Injectée par `src/bootstrap.ts` de chaque app (L6-00, critère d'acceptation 7 : un seul appel à
# `configureMapsProvider` au démarrage). Deux clés Google Cloud Console distinctes en production,
# restreintes différemment (l'une par empreinte d'app, l'autre par API activée) -- jamais la même
# valeur recopiée deux fois.
BABANA_GOOGLE_MAPS_API_KEY=
# Adresse de la recherche de lieu (`searchPlace`, L6-01), consommée au **build** de l'app (donc
# lue de `process.env` de l'hôte, jamais d'un conteneur). PAS de valeur ici (D43, voir
# l'en-tête) : `make client` / `make client-web` posent la valeur de développement
# (http://localhost:4001/search -- mock-maps expose son port à l'hôte, le navigateur l'atteint
# sans passer par Caddy) ; un build de production pose l'adresse Google réelle. Non configurée,
# searchPlace lève au lieu d'appeler silencieusement Google. Le scénario de démonstration désigne
# les points en glissant la carte, pas par recherche -- cette variable n'y est pas requise.
BABANA_MAPS_SEARCH_URL=
# Distance de référence (L2-05, É8 : modèle voiture, ni Google ni Mapbox ne routent les
# deux-roues au Cameroun). PAS de valeur ici (D43, voir l'en-tête) : infra/compose.dev.yaml pose
# http://mock-maps:4001/route pour le développement, la production pose une vraie API de routage.
# routing.py::_routing_url lève si la variable est absente ; deploy.sh refuse de partir.
GOOGLE_ROUTING_URL=
