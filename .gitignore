# Dépendances et artefacts de build — reconstruits par `make` / `npm run build`, jamais commités.
node_modules/
dist/
dist-web/
build/
*.tsbuildinfo
__pycache__/
*.pyc

# Secrets locaux (invariant 5 : aucun secret dans le dépôt).
.env
.env.local
*.env.local

# Système
.DS_Store

# État local de la mise en production (deploy.sh) -- propre à chaque hôte, jamais versionné.
code/infra/production/.state/

# Configuration Firebase des apps (15 novembre) : générée depuis le projet babana-cm
# (code/docs/firebase.md), jamais versionnée.
code/apps/*/android/app/google-services.json
code/apps/*/ios/GoogleService-Info.plist
